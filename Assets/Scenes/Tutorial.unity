  m_text: "\u0411\u043E\u0439\n\n\u0414\u043B\u044F \u0430\u0442\u0430\u043A\u0438
    \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
    \u043A\u0443\u0440\u0441\u043E\u0440\u043E\u043C \u043C\u044B\u0448\u0438 \u0432
    \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u0437\u0430\u0436\u0438\u043C\u0430\u044F
    \u041B\u041A\u041C.\n\n\u0423\u0440\u043E\u043D \u0437\u0430\u0432\u0438\u0441\u0438\u0442
    \u043E\u0442 \u0443\u0433\u043B\u043E\u0432 \u0443\u0434\u0430\u0440\u043E\u0432
    \u043F\u043E \u0432\u0440\u0430\u0433\u0443.\n\n\u0415\u0441\u043B\u0438 \u0431\u0438\u0442\u044C
    \u043F\u043E\u0434 \u043E\u0434\u043D\u0438\u043C\u0438 \u0438 \u0442\u0435\u043C\u0438
    \u0436\u0435 \u0443\u0433\u043B\u0430\u043C\u0438, \u0442\u043E \u0443\u0440\u043E\u043D
    \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439."
